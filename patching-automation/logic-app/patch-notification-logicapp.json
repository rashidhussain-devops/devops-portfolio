{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "logicAppName": {
      "type": "string",
      "defaultValue": "logic-patch-notifications"
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    },
    "sendGridApiKey": {
      "type": "securestring",
      "metadata": {
        "description": "SendGrid API key — pass via deployment parameter file or Key Vault reference, never committed."
      }
    },
    "notifyDistributionList": {
      "type": "string",
      "defaultValue": "platform-team@example.com"
    }
  },
  "resources": [
    {
      "type": "Microsoft.Web/connections",
      "apiVersion": "2016-06-01",
      "name": "sendgrid",
      "location": "[parameters('location')]",
      "properties": {
        "displayName": "sendgrid-patch-notifications",
        "api": {
          "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'sendgrid')]"
        },
        "parameterValues": {
          "apiKey": "[parameters('sendGridApiKey')]"
        }
      }
    },
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[parameters('logicAppName')]",
      "location": "[parameters('location')]",
      "dependsOn": ["[resourceId('Microsoft.Web/connections', 'sendgrid')]"],
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "triggers": {
            "manual": {
              "type": "Request",
              "kind": "Http",
              "inputs": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "pipeline": { "type": "string" },
                    "runId": { "type": "string" },
                    "targetGroup": { "type": "string" },
                    "status": { "type": "string" },
                    "dryRun": { "type": "boolean" }
                  },
                  "required": ["pipeline", "status", "targetGroup"]
                }
              }
            }
          },
          "actions": {
            "Determine_severity": {
              "type": "Compose",
              "inputs": "@if(equals(triggerBody()?['status'], 'Succeeded'), 'success', 'failure')"
            },
            "Send_notification_email": {
              "type": "ApiConnection",
              "runAfter": { "Determine_severity": ["Succeeded"] },
              "inputs": {
                "host": {
                  "connection": { "name": "@parameters('$connections')['sendgrid']['connectionId']" }
                },
                "method": "post",
                "path": "/v3/mail/send",
                "body": {
                  "personalizations": [
                    {
                      "to": [{ "email": "[parameters('notifyDistributionList')]" }]
                    }
                  ],
                  "from": { "email": "patching-automation@example.com" },
                  "subject": "@{concat('[Patching] ', triggerBody()?['targetGroup'], ' — ', triggerBody()?['status'])}",
                  "content": [
                    {
                      "type": "text/plain",
                      "value": "@{concat('Pipeline: ', triggerBody()?['pipeline'], '\nRun ID: ', triggerBody()?['runId'], '\nTarget group: ', triggerBody()?['targetGroup'], '\nStatus: ', triggerBody()?['status'], '\nDry run: ', string(triggerBody()?['dryRun']))}"
                    }
                  ]
                }
              }
            },
            "Response": {
              "type": "Response",
              "runAfter": { "Send_notification_email": ["Succeeded"] },
              "inputs": { "statusCode": 200 }
            }
          }
        },
        "parameters": {
          "$connections": {
            "value": {
              "sendgrid": {
                "connectionId": "[resourceId('Microsoft.Web/connections', 'sendgrid')]",
                "connectionName": "sendgrid",
                "id": "[subscriptionResourceId('Microsoft.Web/locations/managedApis', parameters('location'), 'sendgrid')]"
              }
            }
          }
        }
      }
    }
  ],
  "outputs": {
    "logicAppTriggerUrl": {
      "type": "string",
      "value": "[listCallbackUrl(resourceId('Microsoft.Logic/workflows/triggers', parameters('logicAppName'), 'manual'), '2019-05-01').value]"
    }
  }
}
